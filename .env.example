# Copy this file to .env.local and fill in your own keys.
# .env.local is gitignored — never commit real keys.

# OpenAI — powers the AI goal planner (/api/goal-plan)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# ElevenLabs — powers the read-aloud button (/api/speak)
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional. Defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM). Browse more at
# https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
